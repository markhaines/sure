<%# Bank picker for a GoCardless connection.

    Institutions are scoped to a country by the API, so the country select reloads the
    list rather than filtering client-side. GB is the default because Enable Banking
    already covers the EU/EEA and GoCardless is the UK path. %>

<div class="max-w-2xl mx-auto p-4 space-y-4">
  <header class="space-y-1">
    <h1 class="text-primary text-xl font-medium"><%= t(".title", default: "Choose your bank") %></h1>
    <p class="text-secondary text-sm">
      <%= t(".subtitle", default: "You will be sent to your bank to approve access. Sure only ever reads balances and transactions.") %>
    </p>
  </header>

  <% if @error_message.present? %>
    <div class="rounded-lg border border-primary bg-container p-3 text-sm text-destructive">
      <%= @error_message %>
    </div>
  <% end %>

  <%= form_with url: select_bank_gocardless_item_path(@gocardless_item), method: :get, data: { turbo_frame: "_top" } do |f| %>
    <label class="block text-sm text-secondary mb-1" for="country"><%= t(".country", default: "Country") %></label>
    <%= f.select :country,
                 options_for_select(
                   [
                     [ "United Kingdom", "GB" ], [ "Ireland", "IE" ], [ "France", "FR" ],
                     [ "Germany", "DE" ], [ "Spain", "ES" ], [ "Italy", "IT" ],
                     [ "Netherlands", "NL" ], [ "Belgium", "BE" ], [ "Portugal", "PT" ],
                     [ "Austria", "AT" ], [ "Denmark", "DK" ], [ "Finland", "FI" ],
                     [ "Sweden", "SE" ], [ "Norway", "NO" ], [ "Poland", "PL" ]
                   ],
                   @country
                 ),
                 {},
                 class: "form-field__input",
                 onchange: "this.form.requestSubmit()" %>
  <% end %>

  <% if @institutions.blank? %>
    <p class="text-secondary text-sm"><%= t(".none", default: "No banks found for this country.") %></p>
  <% else %>
    <ul class="divide-y divide-alpha-black-100 rounded-lg border border-primary bg-container">
      <% @institutions.each do |institution| %>
        <li>
          <%= button_to connect_gocardless_item_path(@gocardless_item),
                        params: { institution_id: institution[:id] },
                        class: "w-full flex items-center gap-3 p-3 hover:bg-surface-hover text-left" do %>
            <% if institution[:logo].present? %>
              <img src="<%= institution[:logo] %>" alt="" class="w-8 h-8 rounded object-contain shrink-0" loading="lazy">
            <% end %>
            <span class="grow">
              <span class="block text-primary text-sm font-medium"><%= institution[:name] %></span>
              <% if institution[:transaction_total_days].present? %>
                <span class="block text-secondary text-xs">
                  <%= t(".history", count: institution[:transaction_total_days].to_i,
                        default: "%{count} days of history") %>
                </span>
              <% end %>
            </span>
            <%= icon "chevron-right", size: "sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
