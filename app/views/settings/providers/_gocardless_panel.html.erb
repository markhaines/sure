<div class="space-y-4">
  <div class="prose prose-sm text-secondary">
    <p class="text-primary font-medium"><%= t("gocardless_items.panel.setup_instructions") %></p>
    <ol>
      <li><%= t("gocardless_items.panel.step_1") %></li>
      <li><%= t("gocardless_items.panel.step_2") %></li>
      <li><%= t("gocardless_items.panel.step_3") %></li>
    </ol>

    <p class="text-primary font-medium"><%= t("gocardless_items.panel.field_descriptions") %></p>
    <ul>
      <li><strong><%= t("gocardless_items.panel.fields.secret_id.label") %>:</strong> <%= t("gocardless_items.panel.fields.secret_id.description") %> <%= t("gocardless_items.panel.required") %></li>
      <li><strong><%= t("gocardless_items.panel.fields.secret_key.label") %>:</strong> <%= t("gocardless_items.panel.fields.secret_key.description") %> <%= t("gocardless_items.panel.required") %></li>
      <li><strong><%= t("gocardless_items.panel.fields.institution_id.label") %>:</strong> <%= t("gocardless_items.panel.fields.institution_id.description") %></li>
      <li><strong><%= t("gocardless_items.panel.fields.institution_name.label") %>:</strong> <%= t("gocardless_items.panel.fields.institution_name.description") %></li>
      <li><strong><%= t("gocardless_items.panel.fields.requisition_id.label") %>:</strong> <%= t("gocardless_items.panel.fields.requisition_id.description") %></li>
      <li><strong><%= t("gocardless_items.panel.fields.agreement_id.label") %>:</strong> <%= t("gocardless_items.panel.fields.agreement_id.description") %></li>
      <li><strong><%= t("gocardless_items.panel.fields.requisition_status.label") %>:</strong> <%= t("gocardless_items.panel.fields.requisition_status.description") %></li>
    </ul>
  </div>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <div class="p-2 rounded-md bg-destructive/10 text-destructive text-sm overflow-hidden">
      <p class="line-clamp-3" title="<%= error_msg %>"><%= error_msg %></p>
    </div>
  <% end %>

  <%
    # Get or initialize a gocardless_item for this family
    # - If family has an item WITH credentials, use it (for updates)
    # - If family has an item WITHOUT credentials, use it (to add credentials)
    # - If family has no items at all, create a new one
    gocardless_item = Current.family.gocardless_items.first_or_initialize(name: "Gocardless Connection")
    is_new_record = gocardless_item.new_record?
  %>

  <%= styled_form_with model: gocardless_item,
                       url: is_new_record ? gocardless_items_path : gocardless_item_path(gocardless_item),
                       scope: :gocardless_item,
                       method: is_new_record ? :post : :patch,
                       data: { turbo: true },
                       class: "space-y-3" do |form| %>
    <%= form.text_field :secret_id,
                        label: t("gocardless_items.panel.fields.secret_id.label"),
                        placeholder: is_new_record ? t("gocardless_items.panel.fields.secret_id.placeholder_new") : t("gocardless_items.panel.fields.secret_id.placeholder_update"),
                        type: :password %>

    <%= form.text_field :secret_key,
                        label: t("gocardless_items.panel.fields.secret_key.label"),
                        placeholder: is_new_record ? t("gocardless_items.panel.fields.secret_key.placeholder_new") : t("gocardless_items.panel.fields.secret_key.placeholder_update"),
                        type: :password %>

    <%= form.text_field :institution_id,
                        label: t("gocardless_items.panel.fields.institution_id.label"),
                        placeholder: is_new_record ? t("gocardless_items.panel.fields.institution_id.placeholder_new") : t("gocardless_items.panel.fields.institution_id.placeholder_update"),
                        value: gocardless_item.institution_id %>

    <%= form.text_field :institution_name,
                        label: t("gocardless_items.panel.fields.institution_name.label"),
                        placeholder: is_new_record ? t("gocardless_items.panel.fields.institution_name.placeholder_new") : t("gocardless_items.panel.fields.institution_name.placeholder_update"),
                        value: gocardless_item.institution_name %>

    <%= form.text_field :requisition_id,
                        label: t("gocardless_items.panel.fields.requisition_id.label"),
                        placeholder: is_new_record ? t("gocardless_items.panel.fields.requisition_id.placeholder_new") : t("gocardless_items.panel.fields.requisition_id.placeholder_update"),
                        value: gocardless_item.requisition_id %>

    <%= form.text_field :agreement_id,
                        label: t("gocardless_items.panel.fields.agreement_id.label"),
                        placeholder: is_new_record ? t("gocardless_items.panel.fields.agreement_id.placeholder_new") : t("gocardless_items.panel.fields.agreement_id.placeholder_update"),
                        value: gocardless_item.agreement_id %>

    <%= form.text_field :requisition_status,
                        label: t("gocardless_items.panel.fields.requisition_status.label"),
                        placeholder: is_new_record ? t("gocardless_items.panel.fields.requisition_status.placeholder_new") : t("gocardless_items.panel.fields.requisition_status.placeholder_update"),
                        value: gocardless_item.requisition_status %>

    <div class="flex justify-end">
      <%= form.submit is_new_record ? t("gocardless_items.panel.save_button") : t("gocardless_items.panel.update_button"),
                      class: "inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium btn btn--primary" %>
    </div>
  <% end %>

  <% items = local_assigns[:gocardless_items] || @gocardless_items || Current.family.gocardless_items.where.not(secret_id: [nil, ""]) %>
  <div class="flex items-center gap-2">
    <% if items&.any? %>
      <div class="w-2 h-2 bg-success rounded-full"></div>
      <p class="text-sm text-secondary"><%= t("gocardless_items.panel.status_configured_html", accounts_path: accounts_path).html_safe %></p>
    <% else %>
      <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
      <p class="text-sm text-secondary"><%= t("gocardless_items.panel.status_not_configured") %></p>
    <% end %>
  </div>
</div>
